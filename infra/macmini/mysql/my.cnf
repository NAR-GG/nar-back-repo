# NAR DB (맥미니) — 춘천 Oracle VM(MySQL 8.0.42)의 복제본으로 시작해 컷오버 때 주 DB 가 된다.
#
# 원본은 RAM 952MB 짜리 마이크로라 버퍼풀이 128MB 뿐이었다. 여기는 16GB 라
# DB 전체가 메모리에 올라간다. 응답시간의 대부분이 DB 왕복이었으므로(2026-08-17 실측
# /api/matches 요청당 64 쿼리) 이 차이가 그대로 체감으로 온다.

[mysqld]
# 복제본 식별자. 원본이 1 이므로 겹치면 안 된다.
server_id = 2

# 이 서버도 binlog 를 남긴다. 컷오버 후 역방향 복제(맥미니 → 춘천)를 걸어
# 롤백해도 쓰기를 잃지 않게 하기 위한 것이다.
log_bin = /opt/homebrew/var/mysql/binlog
binlog_format = ROW
binlog_expire_logs_seconds = 604800     # 7일

# 복제본으로 받은 변경도 자기 binlog 에 기록한다. 역방향 복제의 전제.
log_replica_updates = ON

# 복제본인 동안 쓰기를 막는다. 복제 적용 스레드는 read_only 를 우회하므로 복제는 정상 동작한다.
# 재기동해도 유지되도록 설정 파일에 둔다 — 런타임에만 켜두면 재부팅 후 쓰기가 열린다.
#
# 컷오버 때 이 두 줄을 지우고 SET GLOBAL 로도 푼다. 설정만 지우고 재기동을 안 하면
# 런타임 값이 남고, 런타임만 풀고 설정을 안 지우면 다음 재기동에 앱이 깨진다.
read_only = ON
super_read_only = ON

# 원본 nar_dev 계정이 mysql_native_password 를 쓴다. 8.4 는 이 플러그인이 기본 OFF 라
# 켜지 않으면 앱이 인증에 실패한다.
# ponytail: 9.x 에서는 플러그인이 아예 제거된다. 이전이 끝나면 계정을
#   caching_sha2_password 로 바꾸고 JDBC 에 allowPublicKeyRetrieval=true 를 더하는 쪽으로 옮긴다.
mysql_native_password = ON

# 1.7GB 짜리 DB 를 통째로 담고도 남게 잡는다. 맥미니 16GB 중 6GB.
innodb_buffer_pool_size = 2G   # DB 1.3GB 라 통째로 올라간다. 나머지는 Colima·macOS 몫.

# 원본과 문자셋을 맞춘다(utf8mb4 / utf8mb4_unicode_ci).
character_set_server = utf8mb4
collation_server = utf8mb4_unicode_ci

# 외부 노출 없음. 앱 컨테이너는 Colima VM 을 통해 host.docker.internal 로 붙는다.
# 127.0.0.1 = 앱 컨테이너(Colima NAT 경유), 100.111.167.92 = Tailscale.
# Tailscale 주소가 필요한 이유는 컷오버 후 역방향 복제(맥미니 → 춘천)를 걸기 때문이다.
# 춘천이 여기로 붙어야 하는데, 로컬 바인딩만으로는 못 온다.
# LAN(192.168.219.x)에는 열지 않는다.
bind_address = 127.0.0.1,100.111.167.92
max_connections = 200
