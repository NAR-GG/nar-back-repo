<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Cloudflare Tunnel 상시 실행.

  brew 가 깔아주는 homebrew.mxcl.cloudflared.plist 는 인자 없이 실행해서
  사용법만 찍고 죽는다(tunnel run 이 빠져 있다). 그래서 직접 만든다.
  sudo cloudflared service install 을 쓰면 LaunchDaemon 이 되지만 비밀번호가
  필요하고, 어차피 Colima 가 사용자 에이전트라 자동 로그인이 전제이므로
  사용자 에이전트로 통일한다.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nar.cloudflared</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/cloudflared</string>
        <string>--config</string>
        <string>/opt/homebrew/etc/cloudflared/config.yml</string>
        <string>--no-autoupdate</string>
        <string>tunnel</string>
        <string>run</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/opt/homebrew/var/log/nar-cloudflared.log</string>
    <key>StandardErrorPath</key>
    <string>/opt/homebrew/var/log/nar-cloudflared.log</string>
</dict>
</plist>
