    {
      "type": "timeseries",
      "title": "세트 이벤트 (5분 버킷)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({namespace=\"nar\", pod=~\"nar-scheduler.*\"} |= \"set-start(frame)\" [5m]))",
          "legendFormat": "세트 시작"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({namespace=\"nar\", pod=~\"nar-scheduler.*\"} |= \"[live-notify] set-end(\" [5m]))",
          "legendFormat": "세트 종료"
