    {
      "type": "logs",
      "title": "라이브 이벤트 스트림 (실시간)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"nar\", pod=~\"nar-scheduler.*\"} |~ \"\\\\[(live-notify|live-activity|live-discovery|solo-rank-end)\\\\]\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      }
    }
