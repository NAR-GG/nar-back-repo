        {
          "refId": "C",
          "expr": "sum(count_over_time({namespace=\"nar\", pod=~\"nar-scheduler.*\"} |= \"[live-discovery] 신규 추적\" [5m]))",
          "legendFormat": "신규 추적"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
